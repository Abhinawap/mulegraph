{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_main.py",
            "args": [],
            "timeout": 10,
            "statusMessage": "Checking branch"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/project_state.py",
            "args": [],
            "timeout": 10,
            "statusMessage": "Reading project state"
          }
        ]
      }
    ]
  }
}
