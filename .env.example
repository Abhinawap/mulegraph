# mulegraph — example environment file
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# Nothing here is a secret by design except the dataset-download credentials.
# Runtime behaviour (regimes, seeds, search budget) lives in configs/*.yaml, not here.

# ─────────────────────────────────────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────────────────────────────────────
# Root under which raw downloads and content-hashed caches live.
#   $MULEGRAPH_DATA_DIR/raw/<dataset>/<version>/...
#   $MULEGRAPH_DATA_DIR/cache/<dataset>/<version>/{graph.pt,features/,splits/}
MULEGRAPH_DATA_DIR=./data

# Where result tables and figures are written (report/tables, report/figures).
MULEGRAPH_REPORT_DIR=./report

# ─────────────────────────────────────────────────────────────────────────────
# Experiment tracking (MLflow, local file store — no server)
# ─────────────────────────────────────────────────────────────────────────────
# A local SQLite file, not MLflow's `file:` store: MLflow 3 refuses the latter
# ("in maintenance mode"). Still one file and no server.
# Browse with: uv run mlflow ui --backend-store-uri sqlite:///mlruns/mlflow.db
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# ─────────────────────────────────────────────────────────────────────────────
# Dataset download credentials
# Elliptic++ and AMLworld are both distributed via Kaggle. Create a token at
# https://www.kaggle.com/settings > "Create New Token" and paste the values.
# Leave blank if you place the raw files under $MULEGRAPH_DATA_DIR/raw manually.
# ─────────────────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Compute / device
# ─────────────────────────────────────────────────────────────────────────────
# GPU selection for PyTorch / PyG. Empty string forces CPU.
CUDA_VISIBLE_DEVICES=0
# Overrides the config `device`: auto | cuda | cpu
MULEGRAPH_DEVICE=cuda
# Thread caps for XGBoost / numpy on shared or HPC nodes.
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

# ─────────────────────────────────────────────────────────────────────────────
# Reproducibility (NFR-1) — keep set for every real run
# ─────────────────────────────────────────────────────────────────────────────
PYTHONHASHSEED=0
CUBLAS_WORKSPACE_CONFIG=:4096:8

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
MULEGRAPH_LOG_LEVEL=INFO
