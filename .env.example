# mulegraph: the environment variables the code reads, with their defaults. Every one is optional.
# Nothing loads this file for you: copy it to `.env` (git-ignored), then export it into your shell,
#   set -a; . ./.env; set +a
# Experiment settings (regimes, seeds, models) live in configs/*.yaml, not here.

# Raw datasets and content-hashed caches: $MULEGRAPH_DATA_DIR/{raw,cache}/<dataset>/<version>/
MULEGRAPH_DATA_DIR=./data

# Result tables and figures: $MULEGRAPH_REPORT_DIR/{tables,figures}/
MULEGRAPH_REPORT_DIR=./report

# MLflow run store, a local SQLite file (MLflow 3 refuses its `file:` store).
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Overrides every config's `device` (auto | cuda | cpu). Unset, each config decides.
# MULEGRAPH_DEVICE=auto

MULEGRAPH_LOG_LEVEL=INFO
